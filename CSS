body {
background-image: url('https://avatars.mds.yandex.net/i?id=d2204025022a172bda039c8d55b796b042f665cd-8255800-images-thumbs&ref=rim&n=33&w=399&h=300');
font-family: Arial, sans-serif;
margin: 0;
padding: 0;
}
header {
background-color: #f0f0f0;
text-align: center;
padding: 20px;
}
h1 {
font-family: "Times New Roman", serif;
color: #800080;
font-size: 2.5em;
margin: 0;
}
h2, h3 {
text-align: center;
}
p {
font-size: 1.1em;
line-height: 1.6;
padding: 0 20px;
}
strong { font-weight: bold; }
em { font-style: italic; }
img {
max-width: 100%;
height: auto;
display: block;
margin: 10px auto;
}
hr {
border: 0;
height: 1px;
background: #ccc;
margin: 20px 0;
}
ul {
padding: 0 20px;
}
footer {
background-color: #343a40;
color: white;
text-align: left;
padding: 10px 20px;
font-size: 0.9em;
}
